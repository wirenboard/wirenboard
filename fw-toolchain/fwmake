#!/bin/bash
# fwmake — run make from the current directory inside the fw-toolchain
# container. Standalone, like wbdev: it can be downloaded separately:
#
#   wget https://raw.githubusercontent.com/wirenboard/wirenboard/master/fw-toolchain/fwmake
#
# Usage (from a firmware repo checkout):
#   fwmake                      # build all models
#   fwmake MODEL_MR6C_GD32E230K8
#   fwmake unittests
#   fwmake coverage
#
# FWMAKE_IMAGE overrides the image (e.g. a pinned digest), DOCKER — the
# docker binary.
set -u -e

FWMAKE_IMAGE="${FWMAKE_IMAGE:-registry.wirenboard.com/wirenboard/fw-toolchain:latest}"
DOCKER="${DOCKER:-docker}"

exec "$DOCKER" run --rm \
    -u "$(id -u):$(id -g)" -e HOME=/tmp \
    -v "$PWD":/w -w /w \
    "$FWMAKE_IMAGE" make "$@"
