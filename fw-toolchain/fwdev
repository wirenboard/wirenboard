#!/bin/bash
# fwdev — run any command inside the fw-toolchain container as if the
# host had the toolchain installed. The current directory is bind-mounted
# into the container (no copying): the command reads your checkout and
# writes build artifacts straight back into it, owned by you. A docker
# build differs from a local one only by the `fwdev` prefix.
#
# Standalone, like wbdev — can be downloaded separately:
#
#   wget https://raw.githubusercontent.com/wirenboard/wirenboard/master/fw-toolchain/fwdev
#
# Usage (from a firmware repo checkout):
#   fwdev make                        # build all models
#   fwdev make MODEL_MR6C_GD32E230K8  # one model
#   fwdev make unittests
#   fwdev bash                        # interactive shell (same as no args)
#
# FWDEV_IMAGE overrides the image (e.g. a pinned digest), DOCKER — the
# docker binary.
set -u -e

FWDEV_IMAGE="${FWDEV_IMAGE:-registry.wirenboard.com/wirenboard/fw-toolchain:latest}"
DOCKER="${DOCKER:-docker}"

# stdin always goes to the container: piped input reaches the command
# (VSCode talks to gdb over pipes). Like ssh without -n, fwdev then reads
# the caller's stdin — inside a `while read` loop add </dev/null.
tty_flags="-i"
[ -t 0 ] && [ -t 1 ] && tty_flags="-it"

[ $# -eq 0 ] && set -- bash

# The checkout is mounted at the same path as on the host, not at a
# fixed one: the paths the build prints (e.g. the file:// links of the
# coverage reports, made from $(CURDIR)) then lead to the files on the
# host. CI does the same: Jenkins mounts the workspace at its own path.
#
# GIT_CONFIG_*: docker presents the bind-mount root itself as owned by
# root, while everything inside it carries your uid. git checks the
# ownership of the worktree root, refuses the repository ("detected
# dubious ownership in repository at '<checkout>'"), and $(shell git ...)
# in a Makefile silently yields an empty string — artifact names and the
# firmware end up with no branch/commit. Trusting the checkout restores
# it; the env form needs no writable git config inside the container.
#
# --init: PID 1 in the container is docker's tiny init (tini), the
# command runs as its child. The kernel applies no default signal
# actions to PID 1 and hands it the orphans to reap, which make is not
# built for: when the terminal of a running build goes away (a VSCode
# task restarted or closed), the rest of the build stops, but make, as
# PID 1, stays and spins at 100% CPU. tini forwards signals, reaps
# zombies and exits with the command's status.
exec "$DOCKER" run --rm --init $tty_flags \
    -u "$(id -u):$(id -g)" -e HOME=/tmp \
    -e GIT_CONFIG_COUNT=1 \
    -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0="$PWD" \
    -v "$PWD":"$PWD" -w "$PWD" \
    "$FWDEV_IMAGE" "$@"
