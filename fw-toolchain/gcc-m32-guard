#!/bin/sh
# Обёртка над host-gcc: ставится в /usr/local/bin/gcc и по PATH перекрывает
# /usr/bin/gcc. Все вызовы прозрачно передаются настоящему gcc, кроме сборок
# с -m32: 32-битного окружения в образе нет, поэтому падаем сразу и с одной
# и той же понятной ошибкой на amd64- и arm64-хостах. Без обёртки x86-gcc
# принял бы -m32 и упал бы позже с невнятной ошибкой про заголовки, а
# arm64-gcc — со своим текстом про неизвестный флаг.
for a in "$@"; do
    if [ "$a" = "-m32" ]; then
        echo "fw-toolchain: -m32 is not supported; the build fails identically on amd64 and arm64 hosts" >&2
        exit 1
    fi
done
exec /usr/bin/gcc "$@"
