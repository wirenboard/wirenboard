Patch 1 - counter type -> 8-bit, RUNTIME-gated on env GCOV_FLAG_MODE (else stock 64/32-bit). Applied by REBUILD.sh via sed.

--- a/gcc/coverage.cc
+++ b/gcc/coverage.cc
@@ -138,7 +138,7 @@
 get_gcov_type (void)
 {
   scalar_int_mode mode
-    = smallest_int_mode_for_size (LONG_LONG_TYPE_SIZE > 32 ? 64 : 32);
+    = smallest_int_mode_for_size (getenv ("GCOV_FLAG_MODE") ? 8 : (LONG_LONG_TYPE_SIZE > 32 ? 64 : 32));
   return lang_hooks.types.type_for_mode (mode, false);
 }
